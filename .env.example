# Copy this file to `.env` to customize the deployment.

# Host directory where Instagram backups are written.
# The app writes <username>_<N>.jpg files into per-profile subfolders here.
# Defaults to ./backups (next to docker-compose.yml) if unset.
#
# NOTE: if your path contains spaces, do NOT quote it here (the quotes would
# become part of the path). A path with spaces works, but is more reliable via
# the long-form bind mount in docker-compose.yml — see the comment there.
MEDIA_PATH=./backups

# Own the downloaded files and database as this host user/group.
# Find yours with `id -u` and `id -g`.
PUID=1000
PGID=1000
